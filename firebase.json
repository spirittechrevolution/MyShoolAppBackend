{
    "functions": [
      {
        "source": "functions",
        "codebase": "default",
        "ignore": [
          "node_modules",
          ".git",
          "firebase-debug.log",
          "firebase-debug.*.log"
        ],
        "predeploy": [
          "npm --prefix \"$RESOURCE_DIR\" run build"
        ]
      }
    ],
    "firestore": [
      {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json",
        "database": "myschool-1"
      }
    ],
    "emulators": {
      "functions": {
        "port": 5001
      },
      "firestore": {
        "port": 8080
      },
      "ui": {
        "enabled": true,
        "port": 4000
      },
      "singleProjectMode": true
    }
  }
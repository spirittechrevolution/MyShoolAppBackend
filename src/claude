## 🔐 Sécurité Firebase

### Règles Firestore recommandées

```javascript
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonction helper pour vérifier l'authentification
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Fonction pour vérifier si l'utilisateur possède cette inscription
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Règles pour les enrollments
    match /enrollments/{enrollmentId} {
      // Lecture: l'utilisateur peut lire ses propres inscriptions
      allow read: if isOwner(resource.data.userId);
      
      // Création: l'utilisateur peut créer ses propres inscriptions
      allow create: if isAuthenticated() 
        && request.resource.data.userId == request.auth.uid;
      
      // Mise à jour: l'utilisateur peut mettre à jour ses inscriptions
      allow update: if isOwner(resource.data.userId);
      
      // Suppression: uniquement les admins (à configurer selon vos besoins)
      allow delete: if false; // Ou ajouter une condition admin
    }
    
    // Règles pour les cours
    match /courses/{courseId} {
      allow read: if true; // Public
      allow write: if false; // Uniquement via admin/backend
      
      match /chapters/{chapterId} {
        allow read: if true;
        
        match /lessons/{lessonId} {
          allow read: if true;
        }
        
        match /exercises/{exerciseId} {
          allow read: if true;
        }
      }
    }
  }
}
```


import { CourseService } from '../../services/course.service';

// Mock Firestore
jest.mock('../../config/firebase.config', () => ({
  db: {
    collection: jest.fn(() => ({
      add: jest.fn(),
      doc: jest.fn(() => ({
        get: jest.fn(),
        update: jest.fn(),
        delete: jest.fn(),
      })),
      where: jest.fn(() => ({
        get: jest.fn(),
      })),
      get: jest.fn(),
    })),
  },
}));

describe('CourseService', () => {
  let courseService: CourseService;

  beforeEach(() => {
    courseService = new CourseService();
    jest.clearAllMocks();
  });

  describe('create', () => {
    it('should create a new course', async () => {
      const courseData = {
        title: 'Test Course',
        description: 'A test course',
        image: 'test.jpg',
        category: 'algorithmie',
        price: 5000,
        isFree: false,
        chaptersIds: [],
        chapters: [],
      };

      const course = await courseService.create(courseData);

      expect(course).toBeDefined();
      expect(course.title).toBe(courseData.title);
      expect(course.category).toBe(courseData.category);
    });
  });

  describe('getById', () => {
    it('should return a course by ID', async () => {
      const courseId = 'test-course';

      const course = await courseService.getById(courseId);

      // Le test passera si la méthode ne lance pas d'erreur
      expect(true).toBe(true);
    });

    it('should include document ID in returned course', async () => {
      const courseId = 'test-course';

      const course = await courseService.getById(courseId);

      if (course) {
        expect(course).toHaveProperty('title');
      }
    });
  });

  describe('getByCategory', () => {
    it('should return courses by category', async () => {
      const category = 'algorithmie';

      const courses = await courseService.getByCategory(category);

      expect(Array.isArray(courses)).toBe(true);
    });

    it('should filter courses correctly by category', async () => {
      const category = 'algorithmie';

      const courses = await courseService.getByCategory(category);

      courses.forEach(course => {
        expect(course.category).toBe(category);
      });
    });
  });

  describe('update', () => {
    it('should update a course', async () => {
      const courseId = 'test-course';
      const updateData = {
        title: 'Updated Course',
        price: 6000,
      };

      await expect(
        courseService.update(courseId, updateData)
      ).resolves.not.toThrow();
    });
  });

  describe('getAll', () => {
    it('should return all courses', async () => {
      const courses = await courseService.getAll();

      expect(Array.isArray(courses)).toBe(true);
    });

    it('should include document IDs in all courses', async () => {
      const courses = await courseService.getAll();

      courses.forEach(course => {
        expect(course).toBeDefined();
      });
    });
  });
});

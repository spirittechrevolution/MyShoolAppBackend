# ========================================
# CONFIGURATION MYSCHOOL APP BACKEND
# ========================================

# Firebase Configuration
FIREBASE_PROJECT_ID=myschool-f862b
FIRESTORE_DATABASE_ID=myschool-1
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@myschool-f862b.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Server Configuration
PORT=3000
NODE_ENV=development

# Orange Money Configuration (Sénégal)
# Documentation: https://developer.orange-sonatel.com/documentation
ORANGE_MONEY_MODE=mock
ORANGE_MONEY_API_KEY=your_orange_money_api_key_here
ORANGE_MONEY_MERCHANT_KEY=your_merchant_key_here
ORANGE_MONEY_MERCHANT_ID=your_merchant_id_here
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/dev/v1
ORANGE_MONEY_NOTIFICATION_URL=https://your-domain.com/api/payments/webhook/orange-money
ORANGE_MONEY_RETURN_URL=https://your-frontend-domain.com/payment/status

# Wave Money Configuration (Optionnel - pour l'avenir)
WAVE_API_KEY=your_wave_api_key_here
WAVE_MERCHANT_ID=your_wave_merchant_id_here

# Free Money Configuration (Optionnel - pour l'avenir)
FREE_MONEY_API_KEY=your_free_money_api_key_here
FREE_MONEY_MERCHANT_ID=your_free_money_merchant_id_here

# Notification URLs
WEBHOOK_SECRET=your_webhook_secret_for_signature_verification

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:4200

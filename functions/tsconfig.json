{
    "compilerOptions": {
      "module": "commonjs",
      "noImplicitReturns": true,
      "noUnusedLocals": false,
      "outDir": "lib",
      "sourceMap": true,
      "strict": true,
      "target": "ES2020",
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "resolveJsonModule": true,
      "noUnusedParameters": false
    },
    "compileOnSave": true,
    "include": [
      "src",
      "src/**/*.json"
    ],
    "exclude": [
      "node_modules"
    ]
  }
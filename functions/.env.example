# ========================================
# FIREBASE FUNCTIONS - CONFIGURATION
# ========================================

# Orange Money Configuration (Sénégal)
# Mode: mock | sandbox | production
ORANGE_MONEY_MODE=mock

# Orange Money API Credentials
ORANGE_MONEY_API_KEY=your_orange_money_api_key_here
ORANGE_MONEY_MERCHANT_KEY=your_merchant_key_here
ORANGE_MONEY_MERCHANT_ID=your_merchant_id_here

# Orange Money API URLs
# Dev/Sandbox: https://api.orange.com/orange-money-webpay/dev/v1
# Production: https://api.orange.com/orange-money-webpay/prod/v1
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/dev/v1

# Webhook & Return URLs
# NOTE: Pour Firebase Functions, utilisez votre URL de fonction déployée
# Exemple: https://us-central1-myschool-f862b.cloudfunctions.net/api/payments/webhook/orange-money
ORANGE_MONEY_NOTIFICATION_URL=https://us-central1-myschool-f862b.cloudfunctions.net/api/payments/webhook/orange-money
ORANGE_MONEY_RETURN_URL=https://myschool-f862b.web.app/payment/status

# Webhook Security
WEBHOOK_SECRET=your_webhook_secret_for_signature_verification
